{
  "name": "verbatrace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "setup": "npm run build && npm run speech-model",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview",
    "check": "npm run build && npm run test:unit && npm run test:server",
    "speech-model": "node scripts/fetch-speech-model.mjs",
    "diarization-model": "node scripts/fetch-diarization-model.mjs",
    "test:server": "node --test scripts/server.test.mjs",
    "test:unit": "node --import tsx --test src/local/export/srt.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sherpaw/speaker-diarization": "0.3.0",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "docx": "^9.13.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.60.0",
    "onnxruntime-web": "1.24.1",
    "parakeet.js": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^19.3.0",
    "react-router-dom": "^7.18.5",
    "react-virtuoso": "^4.12.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "@babel/core": "^7.29.13",
    "@sherpaw/speaker-diarization": {
      "onnxruntime-web": "1.24.1"
    },
    "baseline-browser-mapping": "^2.11.35",
    "browserslist": "^4.29.5",
    "picomatch": "^4.0.7",
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "source-map-js": "^1.2.2",
    "vite": {
      "picomatch": "^4.0.7",
      "postcss": "^8.5.32"
    }
  }
}
